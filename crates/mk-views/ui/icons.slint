// MoneyKeep's own icons (SVG drawings in ./icons, one line style, tinted to the
// theme with `colorize`). Names match the controller's icon names.

export global Icons {
    public pure function get(name: string) -> image {
        if name == "assistant" { return @image-url("icons/assistant.svg"); }
        if name == "gallery" { return @image-url("icons/gallery.svg"); }
        if name == "receipt-pencil" { return @image-url("icons/receipt-pencil.svg"); }
        if name == "outbox" { return @image-url("icons/outbox.svg"); }
        if name == "eye" { return @image-url("icons/eye.svg"); }
        if name == "eye-off" { return @image-url("icons/eye-off.svg"); }
        if name == "sent" { return @image-url("icons/sent.svg"); }
        if name == "back" { return @image-url("icons/back.svg"); }
        if name == "backspace" { return @image-url("icons/backspace.svg"); }
        if name == "bank" { return @image-url("icons/bank.svg"); }
        if name == "calculator-key" { return @image-url("icons/calculator-key.svg"); }
        if name == "card" { return @image-url("icons/card.svg"); }
        if name == "chart-line" { return @image-url("icons/chart-line.svg"); }
        if name == "check" { return @image-url("icons/check.svg"); }
        if name == "chevron-down" { return @image-url("icons/chevron-down.svg"); }
        if name == "chevron-small" { return @image-url("icons/chevron-small.svg"); }
        if name == "close-book" { return @image-url("icons/close-book.svg"); }
        if name == "close" { return @image-url("icons/close.svg"); }
        if name == "divide" { return @image-url("icons/divide.svg"); }
        if name == "document" { return @image-url("icons/document.svg"); }
        if name == "dot" { return @image-url("icons/dot.svg"); }
        if name == "foot-filled" { return @image-url("icons/foot-filled.svg"); }
        if name == "foot" { return @image-url("icons/foot.svg"); }
        if name == "forward" { return @image-url("icons/forward.svg"); }
        if name == "gear-key" { return @image-url("icons/gear-key.svg"); }
        if name == "house-outline" { return @image-url("icons/house-outline.svg"); }
        if name == "info" { return @image-url("icons/info.svg"); }
        if name == "list" { return @image-url("icons/list.svg"); }
        if name == "lock" { return @image-url("icons/lock.svg"); }
        if name == "unlock" { return @image-url("icons/unlock.svg"); }
        if name == "key" { return @image-url("icons/key.svg"); }
        if name == "minus" { return @image-url("icons/minus.svg"); }
        if name == "more" { return @image-url("icons/more.svg"); }
        if name == "multiply" { return @image-url("icons/multiply.svg"); }
        if name == "paperclip" { return @image-url("icons/paperclip.svg"); }
        if name == "pin-filled" { return @image-url("icons/pin-filled.svg"); }
        if name == "pin" { return @image-url("icons/pin.svg"); }
        if name == "plus-minus" { return @image-url("icons/plus-minus.svg"); }
        if name == "plus" { return @image-url("icons/plus.svg"); }
        if name == "redo" { return @image-url("icons/redo.svg"); }
        if name == "scale" { return @image-url("icons/scale.svg"); }
        if name == "star-filled" { return @image-url("icons/star-filled.svg"); }
        if name == "sym-bill" { return @image-url("icons/sym-bill.svg"); }
        if name == "sym-briefcase" { return @image-url("icons/sym-briefcase.svg"); }
        if name == "sym-building" { return @image-url("icons/sym-building.svg"); }
        if name == "sym-calculator" { return @image-url("icons/sym-calculator.svg"); }
        if name == "sym-calendar" { return @image-url("icons/sym-calendar.svg"); }
        if name == "sym-camera" { return @image-url("icons/sym-camera.svg"); }
        if name == "sym-car" { return @image-url("icons/sym-car.svg"); }
        if name == "sym-chart" { return @image-url("icons/sym-chart.svg"); }
        if name == "sym-church" { return @image-url("icons/sym-church.svg"); }
        if name == "sym-dashboard" { return @image-url("icons/sym-dashboard.svg"); }
        if name == "sym-gear" { return @image-url("icons/sym-gear.svg"); }
        if name == "sym-graduation-cap" { return @image-url("icons/sym-graduation-cap.svg"); }
        if name == "sym-heart" { return @image-url("icons/sym-heart.svg"); }
        if name == "sym-house" { return @image-url("icons/sym-house.svg"); }
        if name == "sym-import" { return @image-url("icons/sym-import.svg"); }
        if name == "sym-invoice" { return @image-url("icons/sym-invoice.svg"); }
