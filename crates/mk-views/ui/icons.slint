        if name == "sym-receipt" { return @image-url("icons/sym-receipt.svg"); }
        if name == "sym-reconcile" { return @image-url("icons/sym-reconcile.svg"); }
        if name == "sym-register" { return @image-url("icons/sym-register.svg"); }
        if name == "sym-report" { return @image-url("icons/sym-report.svg"); }
        if name == "sym-shop" { return @image-url("icons/sym-shop.svg"); }
        if name == "sym-star" { return @image-url("icons/sym-star.svg"); }
        if name == "sym-tools" { return @image-url("icons/sym-tools.svg"); }
        if name == "sym-wallet" { return @image-url("icons/sym-wallet.svg"); }
        if name == "tag" { return @image-url("icons/tag.svg"); }
        if name == "theme" { return @image-url("icons/theme.svg"); }
        if name == "tiles" { return @image-url("icons/tiles.svg"); }
        if name == "undo" { return @image-url("icons/undo.svg"); }
        @image-url("icons/dot.svg")
    }
}
