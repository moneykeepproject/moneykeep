// The Picture editor's crop frame (revision 40): the photo moves under a square
// frame; a drag sends "dx,dy" (frame pixels) when the button is released.
component CropFrame inherits Rectangle {
    in property <ItemVm> item;
    property <length> side: item.width > 0 ? item.width : 256px;
    // Frame pixels per photo pixel.
    property <float> scale: side / 1px / max(1, item.maximum);
    property <length> dx;
    property <length> dy;
    width: side;
    height: side;
    clip: true;
    background: Theme.surface-alt;
    accessible-role: image;
    accessible-label: item.label;
    accessible-description: item.desc;
    accessible-id: "crop|" + item.id;
    Image {
        x: -item.number * scale * 1px + dx;
        y: -item.minimum * scale * 1px + dy;
        width: item.picture.width * scale * 1px;
        height: item.picture.height * scale * 1px;
        source: item.picture;
        image-fit: fill;
        accessible-role: none;
    }
    TouchArea {
        mouse-cursor: move;
        moved => {
            if self.pressed {
                dx = self.mouse-x - self.pressed-x;
                dy = self.mouse-y - self.pressed-y;
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up && (dx != 0px || dy != 0px) {
                Act.act(item.id, E.edit, Math.round(dx / 1px) + "," + Math.round(dy / 1px));
                dx = 0px;
                dy = 0px;
            }
        }
    }
    Rectangle {
        border-width: 1px;
        border-color: Theme.border;
    }
}

// A picture on the book's colour that the Keep and Remove brushes paint on while
// `checked` (revision 40): a stroke sends "x,y;x,y;…" in 0–255 when released.
component PaintCanvas inherits Rectangle {
    in property <ItemVm> item;
    property <length> side: item.width > 0 ? item.width : 256px;
    property <string> points;
    width: side;
    height: side;
    border-radius: side < 100px ? 10px : 12px;
    background: item.color;
    clip: true;
    accessible-role: image;
    accessible-label: item.label;
    accessible-description: item.desc;
    accessible-id: "canvas|" + item.id;
    pure function at(x: length, y: length) -> string {
        Math.round(max(0, min(255, x / side * 256))) + "," + Math.round(max(0, min(255, y / side * 256)))
    }
    Image {
        width: 100%;
        height: 100%;
        source: item.picture;
        image-fit: contain;
        accessible-role: none;
    }
    if item.checked: TouchArea {
        mouse-cursor: crosshair;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                points = at(self.mouse-x, self.mouse-y);
            }
            if e.kind == PointerEventKind.up && points != "" {
                Act.act(item.id, E.edit, points + ";" + at(self.mouse-x, self.mouse-y));
                points = "";
            }
        }
        moved => {
            if self.pressed && points != "" {
                points = points + ";" + at(self.mouse-x, self.mouse-y);
            }
        }
        // The brush under the pointer.
        if self.has-hover: Rectangle {
            property <length> r: item.number / 256 * side;
            x: parent.mouse-x - r;
            y: parent.mouse-y - r;
            width: 2 * r;
            height: 2 * r;
            border-radius: r;
            border-width: 1px;
            border-color: #ffffff;
            Rectangle {
                border-radius: parent.border-radius;
                border-width: 1px;
                border-color: #000000;
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
            }
        }
    }
}

// One item.
export component ItemView inherits VerticalLayout {
    in property <ItemVm> item;
    // In a horizontal bar (the top bar): a separator is a short upright line.
    in property <bool> in-row;
    property <string> name: item.label != "" ? item.label : item.text;
    horizontal-stretch: item.grow || item.kind == K.spacer ? 1 : 0;
    alignment: center;

    // Texts.
    if item.kind == K.text || item.kind == K.title || item.kind == K.subtitle || item.kind == K.caption || item.kind == K.amount: Rectangle {
        min-width: item.kind == K.amount ? max(t.min-width, item.width) : item.width > 0 ? item.width : t.min-width;
        property <bool> is-status: item.icon == "status:n" || item.icon == "status:c" || item.icon == "status:r";
        preferred-width: max(t.preferred-width + (item.icon != "" && !is-status ? 22px : 0px), item.width);
        min-height: t.min-height;
        preferred-height: t.preferred-height;
        accessible-role: text;
        // "~": part of the row's own name (a list entry), not read twice.
        accessible-label: item.id == "~" ? "" : name;
        accessible-id: item.id == "~" ? "" : (item.kind == K.title || item.kind == K.subtitle ? "heading|" : "label|") + item.id;
        accessible-description: item.desc;
        // A text named for its row: the words drawn stay readable as its value.
        accessible-value: item.label != "" && item.label != item.text ? item.text : "";
        // A register status mark (app-desktop.md: empty, half-filled or filled
        // circle); the row's text names it.
        if is-status: Rectangle {
            width: 12px;
            height: 12px;
            x: item.align == 2 ? parent.width - 12px : item.align == 1 ? (parent.width - 12px) / 2 : 0px;
            border-radius: 6px;
            border-width: 1.5px;
            border-color: Theme.accent;
            background: item.icon == "status:r" ? Theme.accent : transparent;
            clip: true;
            if item.icon == "status:c": Rectangle {
                x: 0px;
                width: parent.width / 2;
                height: parent.height;
                background: Theme.accent;
            }
        }
        if item.icon != "" && !is-status: Rectangle {
            x: parent.width - 18px;
            width: 18px;
            accessible-role: image;
            accessible-label: item.icon == "paperclip" ? "Has receipts" : item.icon;
            Icon { name: item.icon; width: 16px; height: 16px; tint: Theme.text-secondary; }
        }
        t := Text {
            width: parent.width - (item.icon != "" && !is-status ? 22px : 0px);
            text: item.text;
            visible: !is-status;
            color: item.kind == K.caption && item.tone == 0 ? Theme.text-secondary : Theme.tone(item.tone);
            font-size: item.kind == K.title ? Theme.title-size : item.kind == K.subtitle ? Theme.subtitle-size : item.kind == K.caption ? Theme.caption-size : Theme.body-size;
            font-weight: item.kind == K.title || item.kind == K.subtitle || item.bold ? 600 : 400;
            font-family: item.kind == K.amount || item.mono ? Theme.number-font : "";
            horizontal-alignment: item.align == 2 ? right : item.align == 1 ? center : left;
            vertical-alignment: center;
            wrap: item.kind == K.amount || item.mono ? no-wrap : word-wrap;
            accessible-role: none;
        }
        if item.strike: Rectangle {
            y: parent.height / 2;
            height: 1px;
            x: item.align == 2 ? parent.width - min(t.preferred-width, parent.width) : 0;
            width: min(t.preferred-width, parent.width);
            background: Theme.tone(item.tone);
        }
        if item.desc != "": TipArea {
            tip: item.desc;
            anchor-x: parent.absolute-position.x;
            anchor-y: parent.absolute-position.y + parent.height + 4px;
        }
    }
    // A chip on a colour of its own (subscriptions.md): `value` "chip-dark" or
    // "chip-light" names the text colour chosen for 4.5:1 contrast.
    if item.kind == K.badge: Rectangle {
        property <bool> own: item.value == "chip-dark" || item.value == "chip-light";
        min-width: bt.preferred-width + 2 * Theme.s2;
        height: bt.preferred-height + 4px;
        border-radius: self.height / 2;
        background: own ? item.color : Theme.tone-bg(item.tone);
        accessible-role: text;
        accessible-label: name;
        accessible-id: "label|" + item.id;
        accessible-value: item.label != "" && item.label != item.text ? item.text : "";
        bt := Text {
            text: item.text;
            color: item.value == "chip-dark" ? #000000 : item.value == "chip-light" ? #ffffff : Theme.tone(item.tone);
            font-size: Theme.caption-size;
            font-weight: 600;
            accessible-role: none;
        }
    }
    if item.kind == K.primary: PrimaryButton {
        text: item.text;
        enabled: item.enabled;
        min-width: item.width > 0 ? item.width : 0px;
        horizontal-stretch: item.grow ? 1 : 0;
        has-icon: item.icon != "";
        icon: item.icon != "" ? Icons.get(item.icon) : @image-url("");
        name: name;
        aid: "button|" + item.id;
        tip: item.desc;
        busy: item.value == "busy";
        clicked => { if item.value != "busy" { Act.act(item.id, E.click, ""); } }
    }
    // The button sits in a hover area for its tooltip (the area sees the
    // pointer over its child; clicks stay with the button).
    // The phone draws its own plain buttons from the theme (revision 8).
    if item.kind == K.button && Theme.touch: TouchButton {
        text: item.text;
        enabled: item.enabled;
        min-width: item.width > 0 ? item.width : 0px;
        min-height: max(Theme.control-height, item.number * 1px);
        horizontal-stretch: item.grow ? 1 : 0;
        has-icon: item.icon != "";
        icon: item.icon != "" ? Icons.get(item.icon) : @image-url("");
        name: name;
        aid: "button|" + item.id;
        tip: item.desc;
        clicked => { Act.act(item.id, E.click, ""); }
    }
    if item.kind == K.button && !Theme.touch: TipArea {
        min-width: max(item.width, fb.min-width);
        preferred-width: max(item.width, fb.preferred-width);
        // `number`: a taller button (dashboard shortcuts), in pixels.
        // On a touch screen at least the 48 px tap target.
        min-height: max(fb.min-height, item.number * 1px, Theme.touch ? Theme.control-height : 0px);
        preferred-height: max(fb.preferred-height, item.number * 1px, Theme.touch ? Theme.control-height : 0px);
        horizontal-stretch: item.grow ? 1 : 0;
        tip: item.desc;
        anchor-x: self.absolute-position.x;
        anchor-y: self.absolute-position.y + self.height + 4px;
        fb := Button {
            width: 100%;
            height: 100%;
            text: item.text;
            enabled: item.enabled;
            checkable: false;
            icon: item.icon != "" ? Icons.get(item.icon) : @image-url("");
            colorize-icon: true;
            accessible-label: name;
            accessible-id: "button|" + item.id;
            accessible-description: item.desc;
            clicked => { Act.act(item.id, E.click, ""); }
            // The message band waits while its button has the keyboard's focus
            // (app-desktop.md revision 37).
            changed has-focus => {
                if item.report-focus { Act.act(item.id, self.has-focus ? E.focus : E.blur, ""); }
            }
        }
    }
    if item.kind == K.link: LinkText {
        text: item.text;
        name: name;
        enabled: item.enabled;
        align: item.align;
        aid: "link|" + item.id;
        tip: item.desc;
        clicked => { Act.act(item.id, E.click, ""); }
    }
    // The phone draws its own fields (mobile-capture.md revision 8); the desktop
    // keeps Fluent's.
    if (item.kind == K.field || item.kind == K.password) && !Theme.touch: Field { item: item; }
    if (item.kind == K.field || item.kind == K.password) && Theme.touch: TouchField { item: item; }
    if item.kind == K.suggest: SuggestField { item: item; }
    if item.kind == K.multiline && !Theme.touch: MultiField { item: item; }
    if item.kind == K.multiline && Theme.touch: TouchMultiField { item: item; }
    if item.kind == K.check: CheckMark {
        // The controller decides; the box shows its answer.
        text: item.text;
        checked: item.checked;
        enabled: item.enabled;
        name: name;
        aid: "check|" + item.id;
        tip: item.desc;
        toggled => { Act.act(item.id, E.click, ""); }
    }
    // The phone draws its own switch in the accent colour (mobile-capture.md
    // revision 13); the desktop keeps Fluent's.
    if item.kind == K.switch && Theme.touch: TouchSwitch {
        text: item.text;
        checked: item.checked;
        enabled: item.enabled;
        name: name;
        aid: "switch|" + item.id;
        tip: item.desc;
        toggled => { Act.act(item.id, E.click, ""); }
    }
    if item.kind == K.switch && !Theme.touch: Switch {
        property <bool> model-checked: item.checked;
        text: item.text;
        checked: item.checked;
        enabled: item.enabled;
        accessible-label: name;
        accessible-id: "switch|" + item.id;
        accessible-description: item.desc;
        changed model-checked => { if self.checked != self.model-checked { self.checked = self.model-checked; } }
        toggled => {
            self.checked = !self.checked;
            Act.act(item.id, E.click, "");
        }
    }
    if item.kind == K.radio: Radio { item: item; }
    if item.kind == K.combo: DropDown { item: item; }
    if item.kind == K.menu: MenuButton { item: item; }
    if item.kind == K.tab: ChipTab {
        text: item.text;
        name: name;
        tip: item.desc;
        selected: item.checked;
        enabled: item.enabled;
        icon: item.icon;
        aid: "tab|" + item.id;
        clicked => { Act.act(item.id, E.click, ""); }
    }
    if item.kind == K.toggle && item.color.alpha > 0: Rectangle {
        width: 32px;
        height: 32px;
        border-radius: Theme.radius-small;
        border-width: item.checked ? 2px : 0px;
        border-color: Theme.text;
        accessible-role: button;
        accessible-label: name;
        accessible-id: "toggle|" + item.id;
        accessible-description: item.desc;
        accessible-checkable: true;
        accessible-checked: item.checked;
        accessible-action-default => { Act.act(item.id, E.click, ""); }
        Rectangle {
            width: parent.width - 6px;
            height: parent.height - 6px;
            border-radius: Theme.radius-small - 1px;
            background: item.color;
            if item.checked: Icon { name: "check"; width: 16px; height: 16px; tint: #ffffff; }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { Act.act(item.id, E.click, ""); }
        }
    }
    if item.kind == K.toggle && item.color.alpha == 0: Chip {
        text: item.text;
        name: name;
        tip: item.desc;
        selected: item.checked;
        enabled: item.enabled;
        icon: item.icon;
        aid: "toggle|" + item.id;
        clicked => { Act.act(item.id, E.click, ""); }
    }
    if item.kind == K.menu-check: ChipCheck {
        text: item.text;
        name: name;
        tip: item.desc;
        selected: item.checked;
        enabled: item.enabled;
        icon: item.checked ? "check" : "";
        aid: "menucheck|" + item.id;
        clicked => { Act.act(item.id, E.click, ""); }
    }
    if item.kind == K.icon-button && item.value != "tab": IconButton {
        icon: item.icon;
        name: name;
        tip: item.desc != "" ? item.desc : name;
        enabled: item.enabled;
        checked: item.checked;
        checkable: item.checked || item.value == "toggle";
        aid: "iconbutton|" + item.id;
        focus-request: item.focus;
        clicked => { Act.act(item.id, E.click, ""); }
        // The message pop-up waits while its × has the keyboard's focus
        // (app-desktop.md revisions 37 and 42).
        focus-changed(f) => {
            if item.report-focus { Act.act(item.id, f ? E.focus : E.blur, ""); }
        }
    }
    // An icon that selects a view (the Settings gear): a tab with its state.
    if item.kind == K.icon-button && item.value == "tab": IconTab {
        icon: item.icon;
        name: name;
        tip: item.desc != "" ? item.desc : name;
        enabled: item.enabled;
        checked: item.checked;
        checkable: true;
        aid: "icontab|" + item.id;
        clicked => { Act.act(item.id, E.click, ""); }
    }
    if item.kind == K.icon && item.label == "": Icon { name: item.icon; tint: Theme.tone(item.tone); }
    // A named icon (a startup star) is an image for screen readers.
    if item.kind == K.icon && item.label != "": Rectangle {
        min-width: 16px;
        min-height: 16px;
        accessible-role: image;
        accessible-label: item.label;
        accessible-id: "image|" + item.id;
        accessible-description: item.desc;
        Icon { name: item.icon; tint: Theme.tone(item.tone); }
        if item.desc != "": TipArea {
            tip: item.desc;
            anchor-x: parent.absolute-position.x;
            anchor-y: parent.absolute-position.y + parent.height + 4px;
        }
    }
    if item.kind == K.separator && item.color.alpha == 0 && in-row: Rectangle {
        min-width: 1px + 2 * Theme.s1;
        max-width: 1px + 2 * Theme.s1;
        height: 20px;
        Rectangle { width: 1px; background: Theme.border; }
    }
    if item.kind == K.separator && item.color.alpha == 0 && !in-row: Rectangle {
        min-height: 1px;
        max-height: 1px;
        min-width: 1px;
        background: Theme.border;
    }
    // A colour block (a swatch or an accent bar): `width` × `number` pixels.
    if item.kind == K.separator && item.color.alpha > 0: Rectangle {
        min-width: item.width;
        max-width: item.width;
        min-height: item.number * 1px;
        max-height: item.number * 1px;
        border-radius: min(3px, item.number * 0.5px);
        background: item.color;
    }
    if item.kind == K.spacer: Rectangle {
        min-width: item.width;
        horizontal-stretch: 1;
    }
    if item.kind == K.progress && item.number >= 0: Rectangle {
        min-width: item.width > 0 ? item.width : 96px;
        horizontal-stretch: item.grow ? 1 : 0;
        min-height: 20px;
        accessible-role: progress-indicator;
        accessible-label: name;
        accessible-description: item.desc;
        accessible-value: item.number + "%";
        accessible-id: "progress|" + item.id;
        Rectangle {
            y: (parent.height - self.height) / 2;
            height: 8px;
            border-radius: 4px;
            background: Theme.surface-alt;
            border-width: 1px;
            border-color: Theme.border;
            Rectangle {
                x: 0;
                width: parent.width * min(100, max(0, item.number)) / 100;
                border-radius: 4px;
                // projects.md: a budget bar is amber at the warning percentage, red over budget.
                background: (item.tone == 6 || item.tone == 4 || item.tone == 2) ? Theme.tone(item.tone) : Theme.accent;
                animate width { duration: Theme.normal; }
            }
        }
        if item.desc != "": TipArea {
            tip: item.desc;
            anchor-x: parent.absolute-position.x;
            anchor-y: parent.absolute-position.y + parent.height + 4px;
        }
    }
    if item.kind == K.progress && item.number < 0: Spinner {
        indeterminate: true;
        width: 24px;
        height: 24px;
        accessible-label: name;
    }
    if item.kind == K.image: Rectangle {
        width: item.width > 0 ? item.width : 160px;
        height: item.width > 0 ? item.width * (img.source.height > 0 ? img.source.height / max(1, img.source.width) : 1) : 160px;
        accessible-role: image;
        accessible-label: name;
        accessible-id: "image|" + item.id;
        accessible-description: item.desc;
        accessible-action-default => { Act.act(item.id, E.click, ""); }
        border-radius: Theme.radius-small;
        clip: true;
        img := Image {
            width: 100%;
            height: 100%;
            source: item.picture;
            image-fit: contain;
            accessible-role: none;
        }
        TouchArea { clicked => { Act.act(item.id, E.click, ""); } }
    }
    if item.kind == K.chart: ChartView { chart: item.chart; name: name; id: item.id; }
    if item.kind == K.tile: Tile { item: item; }
    if item.kind == K.picture-choice: PictureChoice { item: item; }
    if item.kind == K.crop-frame: CropFrame { item: item; }
    if item.kind == K.paint-canvas: PaintCanvas { item: item; }
    if item.kind == K.light: Light { item: item; }
    // The phone's touch controls (mobile-capture.md revision 7).
    if item.kind == K.key: KeyButton {
        text: item.text;
        icon: item.icon;
        name: name;
        aid: "key|" + item.id;
        style: item.value == "op" ? 1 : item.value == "primary" ? 2 : item.value == "quiet" ? 3 : 0;
        enabled: item.enabled;
        clicked => { Act.act(item.id, E.click, ""); }
    }
    if item.kind == K.day: DayButton {
        text: item.text;
        name: name;
        aid: "day|" + item.id;
        selected: item.checked;
        today: item.value == "today";
        muted: item.tone == 1;
        enabled: item.enabled;
        clicked => { Act.act(item.id, E.click, ""); }
    }
    if item.kind == K.amount-card: AmountCard {
        caption: item.placeholder;
        symbol: item.value;
        amount: item.text;
        suffix: item.desc;
        unset: item.tone == 1;
        name: name;
        aid: "button|" + item.id;
        clicked => { Act.act(item.id, E.click, ""); }
    }
    if item.kind == K.field-button: FieldButton {
        text: item.text;
        icon: item.icon;
        name: name;
        aid: "button|" + item.id;
        clicked => { Act.act(item.id, E.click, ""); }
    }
    if item.kind == K.thumb: ThumbView {
        picture: item.picture;
        has-picture: item.has-picture;
        text: item.text;
        name: name;
        remove-name: item.desc;
        aid: item.id;
        open => { Act.act(item.id, E.click, ""); }
        remove => { Act.act(item.id, E.click, "remove"); }
    }
    if item.kind == K.slider: HorizontalLayout {
        property <int> model-focus: item.focus;
        changed model-focus => { if model-focus > 0 { sl.focus(); } }
        init => { if model-focus > 0 { sl.focus(); } }
        spacing: Theme.s2;
        sl := Slider {
            min-width: item.width > 0 ? item.width : 200px;
            minimum: item.minimum;
            maximum: item.maximum;
            value: item.number;
            enabled: item.enabled;
            accessible-label: name;
            accessible-id: "slider|" + item.id;
            changed(v) => { Act.act(item.id, E.edit, Math.round(v)); }
        }
    }
    // @group
    if item.kind == K.about-slint: AboutSlint {
        accessible-role: image;
        accessible-label: "About Slint";
        accessible-id: "aboutslint|" + item.id;
        min-height: 100px;
    }
}

