// Item components (texts, buttons, fields, drop-downs, tiles, charts …).
// build.rs also writes a "leaf" copy of this file (components renamed with a
// Leaf suffix, over CellVm) so a table cell can hold a small group of items
// without a component containing itself.

import { Button, LineEdit, TextEdit, CheckBox, Switch, Slider, ProgressIndicator, Spinner, AboutSlint } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { BookPictures } from "pictures.slint";
import { ItemVm, CellVm, ChartVm, K, E, Act, Keys } from "vm.slint";
import { Card, Icon, IconButton, IconTab, Chip, ChipTab, ChipCheck, LinkText, Overlay, PrimaryButton, TouchButton, CheckMark, TouchSwitch, KeyButton, DayButton, AmountCard, FieldButton, ThumbView } from "widgets.slint";
// @leaf-import

// Hover text: show the description of whatever the pointer rests on.
component TipArea inherits TouchArea {
    in property <string> tip;
    in property <length> anchor-x;
    in property <length> anchor-y;
    changed has-hover => {
        if tip == "" { return; }
        if self.has-hover {
            Act.tip = tip;
            Act.tip-x = anchor-x;
            Act.tip-y = anchor-y;
        } else if Act.tip == tip {
            Act.tip = "";
        }
    }
    // The text changed under the pointer (a toggle's tip follows its state).
    changed tip => { if self.has-hover && tip != "" { Act.tip = tip; } }
}

// A single-line field whose text the controller owns.
component Field inherits VerticalLayout {
    in property <ItemVm> item;
    property <string> model-text: item.value;
    property <int> model-focus: item.focus;
    property <int> model-select: item.select;
    spacing: 2px;
    le := LineEdit {
        // In a narrow window fields may give up width.
        min-width: Theme.narrow ? min(item.width > 0 ? item.width : 160px, 72px) : item.width > 0 ? item.width : 160px;
        preferred-width: item.width > 0 ? item.width : 160px;
        horizontal-stretch: item.grow ? 1 : Theme.narrow ? 1 : 0;
        // Taller on a touch screen (mobile-capture.md revision 7).
        min-height: max(Theme.field-height, 32px);
        text: item.value;
        placeholder-text: item.placeholder;
        enabled: item.enabled;
        input-type: item.kind == K.password ? InputType.password : InputType.text;
        horizontal-alignment: item.align == 2 ? right : item.align == 1 ? center : left;
        accessible-label: item.label;
        accessible-id: (item.kind == K.password ? "password|" : "input|") + item.id;
        accessible-description: item.desc;
        edited(t) => { Act.act(item.id, E.edit, t); }
        accepted(t) => { Act.act(item.id, E.enter, t); }
        changed has-focus => { Act.act(item.id, self.has-focus ? E.focus : E.blur, ""); }
        key-pressed(e) => {
            if e.text == Key.UpArrow || e.text == Key.DownArrow || e.text == Key.Escape || e.text == Key.PageUp || e.text == Key.PageDown {
                if Act.key(item.id + "\n" + Keys.name(e)) { return accept; }
            }
            reject
        }
    }
    // A date field's format guide: the rest of the pattern, greyed, right after
    // the typed text while the field has focus (`text` carries it for fields).
    measure := Text {
        text: le.text;
        visible: false;
        height: 0px;
        accessible-role: none;
    }
    if item.text != "" && le.has-focus && item.kind == K.field: Rectangle {
        height: 0px;
        guide := Text {
            x: 11px + measure.preferred-width;
            y: -le.height / 2 - 2px - self.preferred-height / 2;
            visible: self.x + self.preferred-width < le.width - 8px;
            text: item.text;
            color: Theme.text-secondary;
            accessible-role: text;
            accessible-id: "guide|" + item.id;
            accessible-label: self.visible ? item.text : "";
        }
    }
    if item.error != "": Text {
        text: item.error;
        color: Theme.error;
        font-size: Theme.caption-size;
        wrap: word-wrap;
        // Room for every wrapped line (layouts do not ask a text its height for
        // a width): about 6.5 px a character at the caption size.
        min-height: Math.ceil(item.error.character-count * 6.5px / max(1px, self.width)) * (Theme.caption-size * 1.4);
        accessible-role: text;
        accessible-label: item.error;
    }
    changed model-text => { if le.text != model-text { le.text = model-text; } }
    // A field that already has focus but is now another item (the password
    // prompt's field turning into the recovery key field) tells the controller.
    changed model-focus => {
        if model-focus > 0 {
            if le.has-focus { Act.act(item.id, E.focus, ""); } else { le.focus(); }
        }
    }
    changed model-select => { if model-select > 0 { le.select-all(); } }
    // Focus asked for when the field is created takes effect once it is in the
    // window (a focus call during creation is lost).
    property <bool> pending: false;
    Timer {
        interval: 1ms;
        running: pending;
        triggered => {
            pending = false;
            le.focus();
            if model-select > 0 { le.select-all(); }
        }
    }
    init => {
        if model-focus > 0 { pending = true; }
    }
}

// A text field on a touch screen (the phone window; mobile-capture.md revision
// 8). Fluent's LineEdit takes its colours from Fluent's palette, not from the
// theme; this one draws with the theme: a fill of its own (`Theme.field`), the
// main text colour whether or not it has focus, the muted colour for the
// placeholder, and focus adds the accent border only.
// Revision 18: the outline is always visible — 1.5 px in the field border colour
// (3:1 or more against the card, WCAG 1.4.11), 2 px in the accent with focus — and
// the field is at least 44 px tall (52 px: Theme.field-height on the phone).
component TouchField inherits VerticalLayout {
    in property <ItemVm> item;
    property <string> model-text: item.value;
    property <int> model-focus: item.focus;
    property <int> model-select: item.select;
    property <length> pad: 12px;
    spacing: 2px;
    box := Rectangle {
        min-width: item.width > 0 ? item.width : 160px;
        preferred-width: item.width > 0 ? item.width : 160px;
        horizontal-stretch: item.grow ? 1 : 0;
        min-height: Theme.field-height;
        border-radius: Theme.radius-small;
        background: item.enabled ? Theme.field : Theme.surface-alt;
        border-width: ti.has-focus ? 2px : 1.5px;
        border-color: ti.has-focus ? Theme.accent : Theme.field-border;
        opacity: item.enabled ? 1 : 0.6;
        // A tap anywhere in the box, its padding too, puts the cursor in it.
        TouchArea {
            enabled: item.enabled;
            clicked => { ti.focus(); }
        }
        view := Rectangle {
            x: pad;
            width: max(1px, parent.width - 2 * pad);
            height: parent.height;
            clip: true;
            Text {
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                horizontal-alignment: ti.horizontal-alignment;
                text: ti.text == "" && ti.preedit-text == "" ? item.placeholder : "";
                color: Theme.text-secondary;
                font-size: Theme.body-size;
                accessible-role: none;
            }
            ti := TextInput {
                // Long text scrolls so the cursor stays in view.
                property <length> shift: 0px;
                x: min(0px, max(view.width - self.width, self.shift));
                width: max(view.width, self.preferred-width + 2px);
                height: 100%;
                vertical-alignment: center;
                single-line: true;
                text: item.value;
                color: Theme.text;
                font-size: Theme.body-size;
                selection-background-color: Theme.accent-soft;
                selection-foreground-color: Theme.text;
                enabled: item.enabled;
                input-type: item.kind == K.password ? InputType.password : InputType.text;
                horizontal-alignment: item.align == 2 ? right : item.align == 1 ? center : left;
                accessible-label: item.label;
                accessible-id: (item.kind == K.password ? "password|" : "input|") + item.id;
                accessible-description: item.desc;
                accessible-placeholder-text: item.placeholder;
                cursor-position-changed(p) => {
                    if p.x + self.shift < 0px {
                        self.shift = -p.x;
                    } else if p.x + self.shift > view.width - 2px {
                        self.shift = view.width - 2px - p.x;
                    }
                }
                edited => { Act.act(item.id, E.edit, self.text); }
                accepted => { Act.act(item.id, E.enter, self.text); }
                changed has-focus => { Act.act(item.id, self.has-focus ? E.focus : E.blur, ""); }
                key-pressed(e) => {
                    if e.text == Key.UpArrow || e.text == Key.DownArrow || e.text == Key.Escape || e.text == Key.PageUp || e.text == Key.PageDown {
                        if Act.key(item.id + "\n" + Keys.name(e)) { return accept; }
                    }
                    reject
                }
            }
        }
    }
    if item.error != "": Text {
        text: item.error;
        color: Theme.error;
        font-size: Theme.caption-size;
        wrap: word-wrap;
        min-height: Math.ceil(item.error.character-count * 7px / max(1px, self.width)) * (Theme.caption-size * 1.4);
        accessible-role: text;
        accessible-label: item.error;
    }
    changed model-text => { if ti.text != model-text { ti.text = model-text; } }
    changed model-focus => {
        if model-focus > 0 {
            if ti.has-focus { Act.act(item.id, E.focus, ""); } else { ti.focus(); }
        }
    }
    changed model-select => { if model-select > 0 { ti.select-all(); } }
    property <bool> pending: false;
    Timer {
        interval: 1ms;
        running: pending;
        triggered => {
            pending = false;
            ti.focus();
            if model-select > 0 { ti.select-all(); }
        }
    }
    init => {
        if model-focus > 0 { pending = true; }
    }
}

// A multi-line field on a touch screen, drawn like `TouchField` (revision 8).
component TouchMultiField inherits VerticalLayout {
    in property <ItemVm> item;
    property <string> model-text: item.value;
    property <int> model-focus: item.focus;
    property <length> pad: 12px;
    spacing: 2px;
    Rectangle {
        min-width: item.width > 0 ? item.width : 240px;
        min-height: max(96px, ti.preferred-height + 2 * pad);
        horizontal-stretch: item.grow ? 1 : 0;
        border-radius: Theme.radius-small;
        background: item.enabled ? Theme.field : Theme.surface-alt;
        border-width: ti.has-focus ? 2px : 1.5px;
        border-color: ti.has-focus ? Theme.accent : Theme.field-border;
        opacity: item.enabled ? 1 : 0.6;
        clip: true;
        TouchArea {
            enabled: item.enabled;
            clicked => { ti.focus(); }
        }
        Text {
            x: pad;
            y: pad;
            width: parent.width - 2 * pad;
            text: ti.text == "" && ti.preedit-text == "" ? item.placeholder : "";
            color: Theme.text-secondary;
            font-size: Theme.body-size;
            wrap: word-wrap;
            accessible-role: none;
        }
        ti := TextInput {
            x: pad;
            y: pad;
            width: parent.width - 2 * pad;
            height: parent.height - 2 * pad;
            single-line: false;
            wrap: word-wrap;
            text: item.value;
            color: Theme.text;
            font-size: Theme.body-size;
            selection-background-color: Theme.accent-soft;
            selection-foreground-color: Theme.text;
            enabled: item.enabled;
            accessible-role: text-input;
            accessible-label: item.label != "" ? item.label : item.text;
            accessible-id: "multiline|" + item.id;
            accessible-description: item.desc;
            accessible-placeholder-text: item.placeholder;
            edited => { Act.act(item.id, E.edit, self.text); }
            changed has-focus => { Act.act(item.id, self.has-focus ? E.focus : E.blur, ""); }
            key-pressed(e) => {
                // `number` 1: Enter saves instead of starting a new line.
                if item.number == 1 && e.text == Key.Return && !e.modifiers.shift {
                    Act.act(item.id, E.enter, self.text);
                    return accept;
                }
                if e.text == Key.Escape || (e.modifiers.control && e.text == Key.Return) {
                    if Act.key(item.id + "\n" + Keys.name(e)) { return accept; }
                }
                reject
            }
        }
    }
    if item.error != "": Text {
        text: item.error;
        color: Theme.error;
        font-size: Theme.caption-size;
        wrap: word-wrap;
        min-height: Math.ceil(item.error.character-count * 7px / max(1px, self.width)) * (Theme.caption-size * 1.4);
    }
    changed model-text => { if ti.text != model-text { ti.text = model-text; } }
    changed model-focus => { if model-focus > 0 { ti.focus(); } }
    property <bool> pending: false;
    Timer {
        interval: 1ms;
        running: pending;
        triggered => {
            pending = false;
            ti.focus();
        }
    }
    init => { if model-focus > 0 { pending = true; } }
}

// A field with suggestions below it (categories, payees, accounts).
component SuggestField inherits VerticalLayout {
    in property <ItemVm> item;
    property <string> model-text: item.value;
    property <int> model-focus: item.focus;
    property <int> model-select: item.select;
    property <bool> showing: le.has-focus && item.options.length > 0;
    spacing: 2px;
    function show() {
        if showing {
            Overlay.show(item.id, item.options, false, 2, 0, le.absolute-position.x, le.absolute-position.y + le.height + 2px, le.width, "suggestion");
            Overlay.prefix = item.text;
        } else if Overlay.id == item.id {
            Overlay.close();
        }
    }
    le := LineEdit {
        min-width: item.width > 0 ? item.width : 180px;
        horizontal-stretch: item.grow ? 1 : 0;
        text: item.value;
        placeholder-text: item.placeholder;
        enabled: item.enabled;
        accessible-label: item.label != "" ? item.label : item.text;
        accessible-id: "input|" + item.id;
        accessible-description: item.desc;
        edited(t) => { Act.act(item.id, E.edit, t); }
        accepted(t) => {
            if Overlay.open && Overlay.id == item.id && Overlay.current >= 0 {
                Act.act(item.id, E.select, Overlay.current);
                Overlay.close();
            }
            Act.act(item.id, E.enter, t);
        }
        changed has-focus => {
            Act.act(item.id, self.has-focus ? E.focus : E.blur, "");
            show();
        }
        key-pressed(e) => {
            if Overlay.open && Overlay.id == item.id {
                if e.text == Key.DownArrow { Overlay.current = Math.min(Overlay.current + 1, item.options.length - 1); return accept; }
                if e.text == Key.UpArrow { Overlay.current = Math.max(Overlay.current - 1, 0); return accept; }
                if e.text == Key.Escape { Overlay.close(); return accept; }
                if e.text == Key.Tab && !e.modifiers.shift && Overlay.current >= 0 {
                    Act.act(item.id, E.select, Overlay.current);
                    Overlay.close();
                    return reject;
                }
            }
            if e.text == Key.UpArrow || e.text == Key.DownArrow || e.text == Key.Escape || e.text == Key.PageUp || e.text == Key.PageDown {
                if Act.key(item.id + "\n" + Keys.name(e)) { return accept; }
            }
            reject
        }
    }
    if item.error != "": Text {
        text: item.error;
        color: Theme.error;
        font-size: Theme.caption-size;
        wrap: word-wrap;
        // Room for every wrapped line (layouts do not ask a text its height for
        // a width): about 6.5 px a character at the caption size.
        min-height: Math.ceil(item.error.character-count * 6.5px / max(1px, self.width)) * (Theme.caption-size * 1.4);
    }
    changed model-text => {
        if le.text != model-text { le.text = model-text; }
        // New text, new suggestions (highlight back on the first).
        show();
    }
    changed model-focus => { if model-focus > 0 { le.focus(); } }
    changed model-select => { if model-select > 0 { le.select-all(); } }
    changed showing => { show(); }
    property <int> option-count: item.options.length;
    changed option-count => { show(); }
    // Focus asked for when the field is created takes effect once it is in the
    // window (a focus call during creation is lost).
    property <bool> pending: false;
    Timer {
        interval: 1ms;
        running: pending;
        triggered => {
            pending = false;
            le.focus();
            if model-select > 0 { le.select-all(); }
        }
    }
    init => {
        if model-focus > 0 { pending = true; }
    }
}

// A multi-line field.
component MultiField inherits VerticalLayout {
    in property <ItemVm> item;
    property <string> model-text: item.value;
    property <int> model-focus: item.focus;
    spacing: 2px;
    // `number` 1: a single paragraph where Enter saves (Settings → Book,
    // Description) instead of starting a new line.
    FocusScope {
        min-width: item.width > 0 ? item.width : 240px;
        min-height: 72px;
        horizontal-stretch: item.grow ? 1 : 0;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(e) => {
            if item.number == 1 && e.text == Key.Return && !e.modifiers.shift {
                Act.act(item.id, E.enter, te.text);
                return accept;
            }
            // Esc (closes the dialog) and the app's shortcuts reach the controller.
            if e.text == Key.Escape || (e.modifiers.control && e.text == Key.Return) {
                if Act.key(item.id + "\n" + Keys.name(e)) { return accept; }
            }
            reject
        }
    te := TextEdit {
        width: 100%;
        height: 100%;
        text: item.value;
        placeholder-text: item.placeholder;
        enabled: item.enabled;
        wrap: word-wrap;
        accessible-label: item.label != "" ? item.label : item.text;
        accessible-id: "multiline|" + item.id;
        accessible-description: item.desc;
        edited(t) => { Act.act(item.id, E.edit, t); }
        changed has-focus => { Act.act(item.id, self.has-focus ? E.focus : E.blur, ""); }
    }
    }
    if item.error != "": Text {
        text: item.error;
        color: Theme.error;
        font-size: Theme.caption-size;
        wrap: word-wrap;
        // Room for every wrapped line (layouts do not ask a text its height for
        // a width): about 6.5 px a character at the caption size.
        min-height: Math.ceil(item.error.character-count * 6.5px / max(1px, self.width)) * (Theme.caption-size * 1.4);
    }
    changed model-text => { if te.text != model-text { te.text = model-text; } }
    changed model-focus => { if model-focus > 0 { te.focus(); } }
    property <bool> pending: false;
    Timer {
        interval: 1ms;
        running: pending;
        triggered => {
            pending = false;
            te.focus();
        }
    }
    init => { if model-focus > 0 { pending = true; } }
}

// A drop-down list: a button showing the choice; the list opens in the overlay.
component DropDown inherits Rectangle {
    in property <ItemVm> item;
    min-width: item.width > 0 ? item.width : item.grow ? 96px : 160px;
    preferred-width: max(item.width > 0 ? item.width : 160px, lay.preferred-width);
    horizontal-stretch: item.grow ? 1 : 0;
    min-height: Theme.field-height;
    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.focus : Theme.border;
    background: !item.enabled ? Theme.surface-alt : ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : Theme.surface;
    opacity: item.enabled ? 1 : 0.6;
    accessible-role: combobox;
    accessible-label: item.label != "" ? item.label : item.text;
    accessible-value: item.value;
    accessible-id: "combo|" + item.id;
    accessible-description: item.desc;
    accessible-enabled: item.enabled;
    accessible-expandable: true;
    accessible-expanded: Overlay.open && Overlay.id == item.id;
    accessible-action-default => { open(); }
    function open() {
        if !item.enabled { return; }
        Overlay.show(item.id, item.options, false, 1, item.index, root.absolute-position.x, root.absolute-position.y + root.height + 2px, root.width, "option");
        Overlay.search-label = item.placeholder;
        // Entries named "<text> <entry>" from index `minimum` on (font lists).
        if item.text != "" && item.label != "" {
            Overlay.prefix = item.text;
            Overlay.prefix-from = item.minimum;
        }
    }
    // A searched list: the options change while it is open.
    property <int> option-count: item.options.length;
    changed option-count => {
        if Overlay.open && Overlay.id == item.id {
            Overlay.options = item.options;
        }
    }
    lay := HorizontalLayout {
        padding-left: Theme.s3;
        padding-right: Theme.s2;
        spacing: Theme.s2;
        Text {
            text: item.value;
            vertical-alignment: center;
            color: Theme.text;
            font-size: Theme.body-size;
            horizontal-stretch: 1;
            accessible-role: none;
        }
        Icon { name: "chevron-small"; width: 14px; height: 14px; y: (parent.height - self.height) / 2; tint: Theme.text-secondary; }
    }
    ta := TouchArea {
        enabled: item.enabled;
        mouse-cursor: pointer;
        clicked => { fs.focus(); open(); }
    }
    fs := FocusScope {
        // Keys only: a click is the touch area's (a scope that took the
        // press for focus would swallow the first click; revision 32).
        focus-on-click: false;
        enabled: item.enabled;
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return || (e.text == Key.DownArrow && e.modifiers.alt) { open(); return accept; }
            if e.text == Key.DownArrow && item.index < item.options.length - 1 { Act.act(item.id, E.select, item.index + 1); return accept; }
            if e.text == Key.UpArrow && item.index > 0 { Act.act(item.id, E.select, item.index - 1); return accept; }
            reject
        }
    }
}

// A button opening a menu.
component MenuButton inherits Rectangle {
    in property <ItemVm> item;
    // `width`: a larger tap target (the phone's 44 px menu button), square.
    min-width: max(lay.min-width, item.width);
    preferred-width: max(lay.preferred-width, item.width);
    min-height: max(Theme.control-height, item.width);
    border-radius: Theme.radius-small;
    background: item.checked ? Theme.accent-soft : ta.pressed ? Theme.pressed : ta.has-hover || (Overlay.open && Overlay.id == item.id) ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: item.label != "" ? item.label : item.text;
    accessible-id: "menu|" + item.id;
    accessible-description: item.desc;
    accessible-enabled: item.enabled;
    // Selected while one of its screens is open (the Features menu).
    accessible-item-selectable: true;
    accessible-item-selected: item.checked;
    accessible-expandable: true;
    accessible-expanded: Overlay.open && Overlay.id == item.id;
    accessible-action-default => { toggle(); }
    function toggle() {
        if Overlay.open && Overlay.id == item.id {
            Overlay.close();
        } else {
            Overlay.show(item.id, item.options, item.value == "check", 0, item.index, root.absolute-position.x, root.absolute-position.y + root.height + 2px, 200px, item.value == "check" ? "menucheck" : "menuitem");
        }
    }
    lay := HorizontalLayout {
        padding-left: item.text != "" ? Theme.s3 : Theme.s1;
        padding-right: item.text != "" ? Theme.s2 : Theme.s1;
        spacing: Theme.s1;
        if item.icon != "": Icon { name: item.icon; y: (parent.height - self.height) / 2; }
        if item.text != "": Text {
            text: item.text;
            vertical-alignment: center;
            color: item.checked ? Theme.accent : Theme.text;
            font-size: Theme.body-size;
            accessible-role: none;
        }
        // An icon-only menu (⋯) needs no chevron.
        if item.text != "": Icon { name: "chevron-small"; width: 12px; height: 12px; y: (parent.height - self.height) / 2; tint: Theme.text-secondary; }
    }
    ta := TouchArea {
        enabled: item.enabled;
        mouse-cursor: pointer;
        clicked => { toggle(); }
    }
}

// A radio button.
component Radio inherits Rectangle {
    in property <ItemVm> item;
    min-height: 28px;
    min-width: lay.min-width;
    preferred-width: lay.preferred-width;
    accessible-role: radio-button;
    accessible-label: item.label != "" ? item.label : item.text;
    accessible-id: "radio|" + item.id;
    accessible-checkable: true;
    accessible-checked: item.checked;
    accessible-enabled: item.enabled;
    accessible-description: item.desc;
    accessible-action-default => { if item.enabled { Act.act(item.id, E.click, ""); } }
    opacity: item.enabled ? 1 : 0.5;
    lay := HorizontalLayout {
        spacing: Theme.s2;
        Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 9px;
            border-width: item.checked ? 5px : 1px;
            border-color: item.checked ? Theme.accent : fs.has-focus ? Theme.focus : Theme.text-secondary;
            background: Theme.surface;
            animate border-width { duration: Theme.quick; }
        }
        Text {
            text: item.text;
            vertical-alignment: center;
            color: Theme.text;
            font-size: Theme.body-size;
            accessible-role: none;
        }
    }
    TouchArea {
        enabled: item.enabled;
        clicked => { fs.focus(); Act.act(item.id, E.click, ""); }
    }
    fs := FocusScope {
        // Keys only: a click is the touch area's (a scope that took the
        // press for focus would swallow the first click; revision 32).
        focus-on-click: false;
        enabled: item.enabled;
        key-pressed(e) => {
            if e.text == " " { Act.act(item.id, E.click, ""); return accept; }
            reject
        }
    }
}

// A status light (phone capture): a coloured dot.
component Light inherits Rectangle {
    in property <ItemVm> item;
    // Colour, shape and mark all carry the state (WCAG 1.4.1): green filled,
    // yellow with "!", red with "×", grey hollow.
    property <color> fill: item.value == "green" ? (Theme.dark ? #4cc37a : #1e7d46)
        : item.value == "yellow" ? (Theme.dark ? #f2c13d : #b88600)
        : item.value == "red" ? (Theme.dark ? #f06a5f : #b3261e) : transparent;
    width: item.width > 0 ? item.width : 18px;
    height: self.width;
    border-radius: self.width / 2;
    background: fill;
    border-width: item.value == "green" || item.value == "yellow" || item.value == "red" ? (ta.has-hover ? 2px : 0px) : max(2px, self.width * 0.08);
    border-color: item.value == "green" || item.value == "yellow" || item.value == "red" ? Theme.text : Theme.text-secondary;
    accessible-role: none;
    // A light that opens something is a button; one that only shows (the phone's
    // top bar) an image.
    if item.id != "": Rectangle {
        accessible-role: button;
        accessible-label: item.label;
        accessible-id: "light|" + item.id;
        accessible-description: item.desc;
        accessible-value: item.value;
        accessible-action-default => { Act.act(item.id, E.click, ""); }
    }
    if item.id == "": Rectangle {
        accessible-role: image;
        accessible-label: item.label;
        accessible-id: "light|";
        accessible-description: item.desc;
        accessible-value: item.value;
    }
    if item.value == "yellow" || item.value == "red": Text {
        text: item.value == "yellow" ? "!" : "×";
        color: item.value == "yellow" ? #000000 : (Theme.dark ? #000000 : #ffffff);
        font-size: root.width * 0.62;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    ta := TouchArea {
        mouse-cursor: item.id != "" ? pointer : default;
        clicked => { if item.id != "" { Act.act(item.id, E.click, ""); } }
        changed has-hover => {
            if item.desc == "" { return; }
            if self.has-hover {
                Act.tip = item.desc;
                Act.tip-x = root.absolute-position.x;
                Act.tip-y = root.absolute-position.y + root.height + 4px;
            } else if Act.tip == item.desc {
                Act.tip = "";
            }
        }
    }
}

// A chart: paths in a 1000 × 1000 box stretched over the item, labels and legend.
// The controller sizes the drawing (`chart.height`) to what the legend leaves and
// wraps the legend into lines for the width (dashboards.md revision 4), so the
// legend's lines have a fixed height here. Its pieces (bars and points) open what
// they stand for (revision 5): the pointer becomes a hand over them, the piece
// lights up and a tooltip names it; Tab reaches the chart, the arrow keys move
// between the pieces and then the legend, Enter or Space opens.
export component ChartView inherits Rectangle {
    in property <ChartVm> chart;
    in property <string> name;
    in property <string> id;
    // The piece under the pointer, and the one the keyboard is on (the pieces
    // first, then the legend's entries).
    property <int> hover: -1;
    property <int> cur: -1;
    property <int> count: chart.pieces.length + (chart.open-more ? chart.legend-count : 0);
    property <bool> keys: fs.has-focus;
    min-width: lay.min-width;
    min-height: lay.min-height;
    preferred-width: lay.preferred-width;
    preferred-height: lay.preferred-height;
    function hit(i: int) -> string {
        return i < chart.pieces.length ? "p:" + i : "l:" + (i - chart.pieces.length);
    }
    fs := FocusScope {
        // Keys only: a click is the pieces' (a scope that took the press for
        // focus would swallow the first click; app-desktop revision 32).
        focus-on-click: false;
        enabled: count > 0;
        key-pressed(e) => {
            if e.text == Key.RightArrow || e.text == Key.DownArrow {
                cur = Math.min(count - 1, cur + 1);
                return accept;
            }
            if e.text == Key.LeftArrow || e.text == Key.UpArrow {
                cur = Math.max(0, cur - 1);
                return accept;
            }
            if (e.text == Key.Return || e.text == " ") && cur >= 0 {
                Act.act(id, E.click, hit(cur));
                return accept;
            }
            reject
        }
        changed has-focus => {
            if self.has-focus && cur < 0 { cur = 0; }
            if self.has-focus && cur >= count { cur = count - 1; }
            Act.act(id, self.has-focus ? E.focus : E.blur, "");
        }
    }
    // The keyboard's focus ring.
    if keys: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-small;
        border-width: 2px;
        border-color: Theme.focus;
    }
    lay := VerticalLayout {
        spacing: Theme.s2;
        // The drawing is the image a screen reader announces, with the chart's
        // description.
        box := Rectangle {
            height: chart.height > 0 ? chart.height : 180px;
            min-width: 160px;
            accessible-role: image;
            accessible-label: name;
            // The empty chart area opens the chart's report.
            if chart.open-more: TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => { Act.act(id, E.click, ""); }
            }
            for p in chart.paths: Path {
                width: 100%;
                height: 100%;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 1000;
                viewbox-height: 1000;
                // Stretch the 0–1000 box to the chart (the controller laid it out
                // for this aspect).
                fit: fill;
                commands: p.commands;
                fill: p.series-fill ? Theme.series(p.series) : p.fill;
                stroke: p.series-stroke ? Theme.series(p.series) : p.stroke;
                stroke-width: p.stroke-width * 1px;
                accessible-role: none;
            }
            for l in chart.labels: Text {
                // Kept inside the chart (the controller's text widths are estimates).
                x: max(0px, min(box.width - self.preferred-width, l.align == 2 ? box.width * l.x / 1000 - self.preferred-width : l.align == 1 ? box.width * l.x / 1000 - self.preferred-width / 2 : box.width * l.x / 1000));
                y: box.height * l.y / 1000 - self.preferred-height / 2;
                text: l.text;
                color: Theme.text-secondary;
                font-size: Theme.caption-size;
                accessible-role: text;
                accessible-label: l.text;
                accessible-id: "chartlabel|";
            }
            // The axis ticks for screen readers (not part of the layout, so it
            // takes no room from the legend).
            if chart.note != "": Text {
                x: 0;
                y: 0;
                width: 1px;
                height: 1px;
                text: "";
                accessible-role: text;
                accessible-label: chart.note;
            }
            // The piece under the pointer or the keyboard: a bar a little lighter,
            // a point ringed.
            for p[i] in chart.pieces: Rectangle {
                visible: hover == i || (keys && cur == i);
                x: box.width * p.mx0 / 1000;
                y: box.height * p.my0 / 1000;
                width: box.width * (p.mx1 - p.mx0) / 1000;
                height: box.height * (p.my1 - p.my0) / 1000;
                background: p.ring ? transparent : #ffffff59;
                border-radius: p.ring ? self.width / 2 : 0px;
                border-width: p.ring || (keys && cur == i) ? 2px : 0px;
                border-color: p.ring ? Theme.text : Theme.focus;
            }
            for p[i] in chart.pieces: Rectangle {
                x: box.width * p.hx0 / 1000;
                y: box.height * p.hy0 / 1000;
                width: box.width * (p.hx1 - p.hx0) / 1000;
                height: box.height * (p.hy1 - p.hy0) / 1000;
                accessible-role: button;
                accessible-label: p.name;
                accessible-id: "chartpiece|" + id + "/piece:" + i;
                accessible-action-default => { Act.act(id, E.click, "p:" + i); }
                TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { Act.act(id, E.click, "p:" + i); }
                    changed has-hover => {
                        if self.has-hover {
                            hover = i;
                            Act.tip = p.name;
                            Act.tip-x = self.absolute-position.x + self.mouse-x + 12px;
                            Act.tip-y = self.absolute-position.y + self.mouse-y + 16px;
                        } else {
                            if hover == i { hover = -1; }
                            if Act.tip == p.name { Act.tip = ""; }
                        }
                    }
                }
            }
        }
        if chart.legend.length > 0: VerticalLayout {
            spacing: 4px;
            for line in chart.legend: HorizontalLayout {
                height: 16px;
                spacing: Theme.s3;
                alignment: start;
                for entry in line.entries: Rectangle {
                    min-width: 0px;
                    preferred-width: entry-lay.preferred-width;
                    max-width: entry-lay.preferred-width;
                    border-radius: 2px;
                    border-width: keys && cur == chart.pieces.length + entry.index ? 2px : 0px;
                    border-color: Theme.focus;
                    entry-lay := HorizontalLayout {
                        spacing: Theme.s1;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 2px;
                            background: entry.series != -1 ? Theme.series(entry.series) : entry.color;
                        }
                        Text {
                            min-width: 0px;
                            text: entry.text;
                            color: Theme.text-secondary;
                            font-size: Theme.caption-size;
                            vertical-alignment: center;
                            // An estimate too small for the font still never spills.
                            overflow: elide;
                            accessible-role: none;
                        }
                    }
                    // A plain legend entry (a shortened one shows its full text as
                    // a tooltip) …
                    if !chart.open-more: Rectangle {
                        width: 100%;
                        height: 100%;
                        accessible-role: text;
                        accessible-label: "Legend: " + (entry.tip != "" ? entry.tip : entry.text);
                        accessible-id: "legend|";
                        TipArea {
                            width: 100%;
                            height: 100%;
                            tip: entry.tip;
                            anchor-x: parent.absolute-position.x;
                            anchor-y: parent.absolute-position.y + parent.height + 4px;
                        }
                    }
                    // … or one that opens its series.
                    if chart.open-more: Rectangle {
                        width: 100%;
                        height: 100%;
                        accessible-role: button;
                        accessible-label: entry.name;
                        accessible-id: "link|" + id + "/legend:" + entry.index;
                        accessible-action-default => { Act.act(id, E.click, "l:" + entry.index); }
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { Act.act(id, E.click, "l:" + entry.index); }
                            changed has-hover => {
                                if entry.tip == "" { return; }
                                if self.has-hover {
                                    Act.tip = entry.tip;
                                    Act.tip-x = self.absolute-position.x;
                                    Act.tip-y = self.absolute-position.y + self.height + 4px;
                                } else if Act.tip == entry.tip {
                                    Act.tip = "";
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// A book or feature tile: a coloured square with a letter, symbol or picture, the
// name centred under it.
// A square action tile (the phone's home screen, mobile-capture.md revision 5): a
