        focus-on-click: false;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { Act.act(item.id, E.click, ""); return accept; }
            reject
        }
    }
    if fs.has-focus: Rectangle {
        x: -3px; y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 19px;
        border-width: 2px;
        border-color: Theme.focus;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { fs.focus(); Act.act(item.id, E.click, ""); }
    }
}

export component Tile inherits Rectangle {
    in property <ItemVm> item;
    // Smaller in a narrow window (large text), so more fit on a line.
    property <length> square: Theme.narrow ? 72px : 96px;
    width: Theme.narrow ? 140px : 168px;
    height: Theme.narrow ? 152px : 176px;
    accessible-role: button;
    accessible-label: item.label != "" ? item.label : item.text;
    accessible-description: item.desc;
    accessible-id: "tile|" + item.id;
    accessible-enabled: item.enabled;
    accessible-action-default => { Act.act(item.id, E.click, ""); }
    card := Card {
        hoverable: true;
        hovered: ta.has-hover || fs.has-focus;
        pressed: ta.pressed;
        opacity: item.checked ? 0.55 : 1;
        VerticalLayout {
            padding: Theme.s3;
            spacing: Theme.s2;
            alignment: start;
            Rectangle {
                height: square + 8px;
                Rectangle {
                    width: square;
                    height: square;
                    border-radius: Theme.radius;
                    background: item.color;
                    border-width: item.kind == K.tile && item.value == "+" ? 2px : 0px;
                    border-color: Theme.border;
                    clip: true;
                    if item.has-picture: Image {
                        width: 100%;
                        height: 100%;
                        source: item.picture;
                        image-fit: cover;
                        // Part of the tile (its name is the tile's own name).
                        accessible-role: image;
                        accessible-label: "Book picture";
                    }
                    if !item.has-picture && item.icon != "": Icon {
                        name: item.icon;
                        width: square * 0.58;
                        height: square * 0.58;
                        tint: item.value == "+" ? Theme.accent : #ffffff;
                    }
                    if !item.has-picture && item.icon == "": Text {
                        text: item.value;
                        color: item.value == "+" ? Theme.accent : #ffffff;
                        font-size: square * 0.42;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accessible-role: text;
                    }
                }
                // A count (the phone's Outbox tile).
                if item.number > 0: Rectangle {
                    x: parent.width / 2 + 30px;
                    y: 0px;
                    width: max(26px, badge-text.preferred-width + 12px);
                    height: 26px;
                    border-radius: 13px;
                    background: Theme.dark ? #f06a5f : #c02626;
                    badge-text := Text {
                        text: item.number;
                        color: #ffffff;
                        font-size: Theme.caption-size;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
                if item.strike: Rectangle {
                    x: parent.width / 2 + 30px;
                    y: 70px;
                    width: 26px;
                    height: 26px;
                    border-radius: 13px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    accessible-role: text;
                    accessible-label: "Password protected";
                    accessible-id: "label|";
                    Icon { name: "lock"; width: 16px; height: 16px; }
                }
            }
            name-text := Text {
                text: item.text;
                horizontal-alignment: center;
                vertical-alignment: top;
                color: Theme.text;
                font-size: Theme.body-size;
                font-weight: 600;
                wrap: word-wrap;
                overflow: elide;
                height: 40px;
                accessible-role: text;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { fs.focus(); Act.act(item.id, E.click, ""); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up && item.options.length > 0 {
                Overlay.show(item.id, item.options, false, 3, -1, root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y, 200px, "menuitem");
            }
        }
        changed has-hover => {
            if item.desc == "" { return; }
            if self.has-hover {
                Act.tip = item.desc;
                Act.tip-x = root.absolute-position.x;
                Act.tip-y = root.absolute-position.y + root.height + 4px;
            } else if Act.tip == item.desc {
                Act.tip = "";
            }
        }
    }
    fs := FocusScope {
        // Keys only: a click is the touch area's (a scope that took the
        // press for focus would swallow the first click; revision 32).
        focus-on-click: false;
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " { Act.act(item.id, E.click, ""); return accept; }
            if e.text == Key.LeftArrow || e.text == Key.RightArrow || e.text == Key.UpArrow || e.text == Key.DownArrow {
                if Act.key(item.id + "\n" + Keys.name(e)) { return accept; }
            }
            reject
        }
        changed has-focus => { Act.act(item.id, self.has-focus ? E.focus : E.blur, ""); }
    }
    property <int> model-focus: item.focus;
    changed model-focus => { if model-focus > 0 { fs.focus(); } }
    Rectangle {
        border-radius: Theme.radius;
        border-width: fs.has-focus ? 2px : 0px;
        border-color: Theme.focus;
    }
}

