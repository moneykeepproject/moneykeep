<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.1.0-alpha.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@ (docs/specs/macos-release.md P2).
     MoneyKeep opens books from its own File menu and dialogs; no document types are
     registered with Finder yet. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>MoneyKeep</string>
  <key>CFBundleName</key>
  <string>MoneyKeep</string>
  <key>CFBundleExecutable</key>
  <string>MoneyKeep</string>
  <key>CFBundleIdentifier</key>
  <string>com.moneykeep.moneykeep</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>MoneyKeepVersion</key>
  <string>@VERSION@</string>
  <key>MoneyKeepBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>MoneyKeep</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.finance</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © 2026 MoneyKeep Project contributors. MIT OR Apache-2.0.</string>
</dict>
</plist>
